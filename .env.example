# Copia este archivo como .env (no se sube al repositorio) y completa los valores.
# En Vercel estas variables se configuran en Project Settings > Environment Variables.
DB_URL=jdbc:mysql://<host>.aivencloud.com:<puerto>/defaultdb?sslMode=REQUIRED
DB_USER=avnadmin
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
SPRING_PROFILES_ACTIVE=dev
# Contraseña de los usuarios semilla (solo perfil dev, nunca en producción)
SEED_PASSWORD=
# Orígenes permitidos por CORS, separados por comas (URL del frontend)
CORS_ALLOWED_ORIGINS=
# Secreto que autoriza el disparo de las tareas programadas desde Vercel Cron
CRON_SECRET=
# Primer ADMIN en produccion: se crea al arrancar solo si no existe ningun ADMIN activo
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# Hash BCrypt de la contrasena (nunca la contrasena en claro)
BOOTSTRAP_ADMIN_PASSWORD_HASH=
